# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# App Configuration
NEXT_PUBLIC_APP_NAME=Healix
NEXT_PUBLIC_APP_DESCRIPTION=Remote Healthcare Management System

# Stripe (Publishable Key only — never put secret key here)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Feature Flags
NEXT_PUBLIC_ENABLE_TELEMEDICINE=true
NEXT_PUBLIC_ENABLE_PRESCRIPTIONS=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true
